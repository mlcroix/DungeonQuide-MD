generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  email      String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  // Explicit junctions with readable columns
  campaigns_as_dm     Campaign[]        @relation("DungeonMaster")
  campaigns_as_player CampaignPlayer[]
  session_attendees   SessionAttendee[]
  
  @@map("users")
}

model Campaign {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  dungeon_master_id Int
  dungeon_master    User              @relation("DungeonMaster", fields: [dungeon_master_id], references: [id])
  players           CampaignPlayer[]
  sessions          Session[]
  
  @@map("campaigns")
}

model CampaignPlayer {
  campaign_id    Int
  user_id        Int
  joined_at      DateTime @default(now())
  character_name String?
  role           String   @default("player")
  
  campaign Campaign @relation(fields: [campaign_id], references: [id])
  user     User     @relation(fields: [user_id], references: [id])
  
  @@id([campaign_id, user_id])
  @@map("campaign_players")
}

model Session {
  id          Int       @id @default(autoincrement())
  name        String
  campaign_id Int
  created_at  DateTime  @default(now())
  start_date  DateTime
  end_date    DateTime
  updated_at  DateTime  @updatedAt
  
  campaign  Campaign          @relation(fields: [campaign_id], references: [id])
  attendees SessionAttendee[]
  summary   SessionSummary?
  
  @@map("sessions")
}

model SessionAttendee {
  session_id Int
  user_id    Int
  joined_at  DateTime @default(now())
  attended   Boolean  @default(true)
  role       String   @default("player")
  
  session Session @relation(fields: [session_id], references: [id])
  user    User    @relation(fields: [user_id], references: [id])
  
  @@id([session_id, user_id])
  @@map("session_attendees")
}

model SessionSummary {
  id         Int      @id @default(autoincrement())
  title      String
  content    String
  session_id Int      @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  
  session Session @relation(fields: [session_id], references: [id])
  
  @@map("session_summaries")
}